<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>Der Hobbit – Interaktive Karte von Mittelerde</title>

    <style>
        body {
            margin: 0;
            background-color: #1b1b1b;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            font-family: Arial, sans-serif;
            color: #fff;
        }

        .map-container {
            position: relative;
            width: 1000px;
            max-width: 95%;
        }

        .map-container img {
            width: 100%;
            display: block;
            border: 4px solid #8b6f3d;
        }

        .marker {
            position: absolute;
            width: 18px;
            height: 18px;
            background-color: #c0392b;
            border-radius: 50%;
            border: 2px solid #fff;
            cursor: pointer;
            transform: translate(-50%, -50%);
        }

        .marker:hover {
            box-shadow: 0 0 10px rgba(255, 100, 100, 0.9);
        }

        .info-box {
            position: absolute;
            bottom: 10px;
            left: 10px;
            right: 10px;
            background: rgba(0, 0, 0, 0.85);
            border: 2px solid #8b6f3d;
            padding: 15px;
            display: none;
        }

        .info-box h2 {
            margin-top: 0;
            color: #f5d76e;
        }

        .close {
            float: right;
            cursor: pointer;
            font-size: 18px;
            color: #ccc;
        }
    </style>
</head>
<body>

<div class="map-container">

    <!-- DAS BILD -->
    <img src="middleearth-hobbit.jpg" alt="Karte von Mittelerde">

    <!-- MARKER -->

    <!-- Das Auenland -->
    <div class="marker" style="top: 60%; left: 22%;"
         onclick="showInfo(
         'Das Auenland',
         'Bilbo Beutlin lebt hier, bis Gandalf ihn auf das Abenteuer mit den Zwergen mitnimmt.'
         )">
    </div>

    <!-- Bruchtal -->
    <div class="marker" style="top: 48%; left: 46%;"
         onclick="showInfo(
         'Bruchtal',
         'Elronds Heim. Hier erhalten die Gefährten wichtige Informationen über ihre Reise.'
         )">
    </div>

    <!-- Nebelgebirge / Gollum -->
    <div class="marker" style="top: 45%; left: 50%;"
         onclick="showInfo(
         'Nebelgebirge',
         'Bilbo trifft hier auf Gollum und findet den Einen Ring.'
         )">
    </div>

    <!-- Düsterwald -->
    <div class="marker" style="top: 48%; left: 65%;"
         onclick="showInfo(
         'Düsterwald',
         'Die Zwerge werden von Spinnen und Waldelben gefangen genommen.'
         )">
    </div>

    <!-- Einsamer Berg -->
    <div class="marker" style="top: 35%; left: 72%;"
         onclick="showInfo(
         'Der Einsame Berg (Erebor)',
         'Smaug wird konfrontiert und die Schlacht der Fünf Heere nimmt ihren Lauf.'
         )">
    </div>

    <!-- INFOBOX -->
    <div class="info-box" id="infoBox">
        <span class="close" onclick="closeInfo()">✖</span>
        <h2 id="infoTitle"></h2>
        <p id="infoText"></p>
    </div>

</div>

<script>
    function showInfo(title, text) {
        document.getElementById("infoTitle").innerText = title;
        document.getElementById("infoText").innerText = text;
        document.getElementById("infoBox").style.display = "block";
    }

    function closeInfo() {
        document.getElementById("infoBox").style.display = "none";
    }
</script>

</body>
</html>
